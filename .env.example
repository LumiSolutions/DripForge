# =============================================================================
# DripForge — environment variables (example)
# Copy: cp .env.example .env.local
# Put real values only in .env.local / Azure App Settings — never commit them.
# =============================================================================

# --- Azure Cosmos DB ---
COSMOSDB_ENDPOINT=https://YOUR_ACCOUNT.documents.azure.com:443/
COSMOSDB_KEY=YOUR_SECRET_HERE
COSMOSDB_DATABASE=dripforge
# COSMOSDB_SETTINGS_CONTAINER=settings

# --- 3D generator API ---
THREE_D_GENERATOR_API_KEY=YOUR_SECRET_HERE
# THREE_D_GENERATOR_API_URL=https://api.meshy.ai/openapi/v2/text-to-3d

# --- Admin & tester passwords (required for login / preview) ---
ADMIN_PASSWORD=CHANGE_ME
TESTER_PASSWORD=CHANGE_ME
# Optional alias:
# PREVIEW_ACCESS_PASSWORD=CHANGE_ME
# Local/emergency only (avoid in production):
# NEXT_PUBLIC_ADMIN_PASSWORD=
# NEXT_PUBLIC_TESTER_PASSWORD=
# Passwort in Cosmos zuruecksetzen: node scripts/reset-staff-password.mjs admin --clear-2fa
# 2FA vorübergehend deaktivieren (Lockout / lokale Dev): ENABLE_ADMIN_2FA=false
# ENABLE_ADMIN_2FA=true

# --- Session & signing secrets (long random strings) ---
ADMIN_SESSION_SECRET=YOUR_SECRET_HERE
CUSTOMER_SESSION_SECRET=YOUR_SECRET_HERE
PASSWORD_RESET_SECRET=YOUR_SECRET_HERE
ADMIN_2FA_ENCRYPTION_KEY=YOUR_SECRET_HERE

# --- Public site URL ---
NEXT_PUBLIC_SITE_URL=https://www.example.com
# NEXTAUTH_URL=https://www.example.com
# NEXTAUTH_SECRET=YOUR_SECRET_HERE

# --- Stripe (shop checkout) ---
STRIPE_SECRET_KEY=YOUR_SECRET_HERE
STRIPE_WEBHOOK_SECRET=YOUR_SECRET_HERE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=YOUR_SECRET_HERE
# Webhook path: /api/webhooks/stripe

# --- TWINT payment link (official Business Portal link) ---
# Prefill: amount + trxInfo (orderId) are appended automatically.
TWINT_PAYMENT_LINK=https://go.twint.ch/1/e/tw?tw=CHANGE_ME
# Optional client mirror (not required; server builds the URL):
# NEXT_PUBLIC_TWINT_PAYMENT_LINK=https://go.twint.ch/1/e/tw?tw=CHANGE_ME

# --- SMTP (Hostpoint) ---
# Host: asmtp.mail.hostpoint.ch
# Port 465 + SMTP_SECURE=true (SSL) — Port 587 wird im Code auf 465 umgebogen
# (Override nur mit SMTP_FORCE_587=true)
SMTP_HOST=asmtp.mail.hostpoint.ch
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=shop@dripforge.ch
# Locally, quote passwords that contain $: SMTP_PASS='CHANGE_ME'
SMTP_PASS=YOUR_SECRET_HERE
# From MUSS eine gültige Hostpoint-Mailbox sein (sonst blockiert Hostpoint):
EMAIL_FROM=DripForge <shop@dripforge.ch>
ADMIN_EMAIL=shop@dripforge.ch
ADMIN_NOTIFY_EMAIL=shop@dripforge.ch
#
# Azure App Settings: store values without surrounding quotes.
# Test: npm run test:smtp

# --- WhatsApp live chat (Meta Cloud API) ---
META_PHONE_NUMBER_ID=CHANGE_ME
META_WHATSAPP_BUSINESS_ACCOUNT_ID=CHANGE_ME
META_ACCESS_TOKEN=YOUR_SECRET_HERE
META_VERIFY_TOKEN=YOUR_SECRET_HERE
META_ADMIN_PHONE_NUMBER=CHANGE_ME

# --- Tawk.to live chat ---
# NEXT_PUBLIC_TAWK_PROPERTY_ID=CHANGE_ME
# NEXT_PUBLIC_TAWK_WIDGET_ID=CHANGE_ME
