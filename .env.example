# =============================================================================
# DripForge — Umgebungsvariablen (Beispiel)
# Kopiere: cp .env.example .env.local
# Trage echte Werte nur in .env.local / Azure App Settings ein — nie committen.
# =============================================================================

# --- Azure Cosmos DB ---
COSMOSDB_ENDPOINT=https://dein-account.documents.azure.com:443/
COSMOSDB_KEY=dein_cosmos_primary_key_hier
COSMOSDB_DATABASE=dripforge
# COSMOSDB_SETTINGS_CONTAINER=settings

# --- 3D-KI-Generator (Meshy AI o.ä.) ---
THREE_D_GENERATOR_API_KEY=dein_api_key_hier
# THREE_D_GENERATOR_API_URL=https://api.meshy.ai/openapi/v2/text-to-3d

# --- Admin- & Tester-Passwörter (Pflicht für Login / Preview) ---
# Keine Repo-Defaults — ohne diese Werte ist Login nicht möglich.
ADMIN_PASSWORD=dein_admin_passwort_hier
TESTER_PASSWORD=dein_tester_passwort_hier
# Optional Alias:
# PREVIEW_ACCESS_PASSWORD=dein_tester_passwort_hier
# Nur lokal / Notfall (vermeiden in Produktion):
# NEXT_PUBLIC_ADMIN_PASSWORD=
# NEXT_PUBLIC_TESTER_PASSWORD=

# --- Session- & Signing-Secrets (lange Zufallsstrings) ---
ADMIN_SESSION_SECRET=dein_admin_session_secret_hier
CUSTOMER_SESSION_SECRET=dein_customer_session_secret_hier
PASSWORD_RESET_SECRET=dein_password_reset_secret_hier
ADMIN_2FA_ENCRYPTION_KEY=dein_2fa_encryption_key_hier

# --- Öffentliche Site-URL ---
NEXT_PUBLIC_SITE_URL=https://www.dripforge.ch
# NEXTAUTH_URL=https://www.dripforge.ch
# NEXTAUTH_SECRET=dein_nextauth_secret_hier

# --- Stripe (Shop-Checkout) ---
STRIPE_SECRET_KEY=sk_test_dein_stripe_secret_hier
STRIPE_WEBHOOK_SECRET=whsec_dein_webhook_secret_hier
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_dein_publishable_key_hier
# Webhook-URL (Live): https://dripforge.ch/api/webhooks/stripe

# --- Hostpoint SMTP ---
SMTP_HOST=mail.hostpoint.ch
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=shop@dripforge.ch
# Passwörter mit $ lokal in Anführungszeichen: SMTP_PASS='mein$Passwort'
SMTP_PASS=dein_passwort_hier
EMAIL_FROM="DripForge <shop@dripforge.ch>"
ADMIN_EMAIL=shop@dripforge.ch
ADMIN_NOTIFY_EMAIL=shop@dripforge.ch
#
# Azure App Settings: Werte ohne umschliessende Anführungszeichen speichern.
# Test: npm run test:smtp

# --- WhatsApp Live-Chat (Meta Cloud API) ---
META_PHONE_NUMBER_ID=dein_phone_number_id_hier
META_WHATSAPP_BUSINESS_ACCOUNT_ID=dein_waba_id_hier
META_ACCESS_TOKEN=dein_meta_access_token_hier
META_VERIFY_TOKEN=dein_verify_token_hier
META_ADMIN_PHONE_NUMBER=41791234567

# --- Tawk.to Live-Chat ---
# NEXT_PUBLIC_TAWK_PROPERTY_ID=dein_tawk_property_id
# NEXT_PUBLIC_TAWK_WIDGET_ID=dein_tawk_widget_id
