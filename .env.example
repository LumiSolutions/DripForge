# =============================================================================
# DripForge — lokale Entwicklung (.env.local)
# Kopiere diese Datei: cp .env.example .env.local
# =============================================================================

# --- Azure Cosmos DB (Pflicht für persistente Admin-Daten) ---
COSMOSDB_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOSDB_KEY=your-cosmos-primary-key
# Datenbank-Name wie im Azure Portal (Default: dripforge)
COSMOSDB_DATABASE=dripforge
# Optional: Settings-Container für Material-Arten, Journal, Config (Default: settings, PK /id)
# COSMOSDB_SETTINGS_CONTAINER=settings

# --- 3D-KI-Generator (Text/Image-to-3D, Standard: Meshy AI) ---
# Ohne Key: Demo-GLB auf /konfigurator/ai
THREE_D_GENERATOR_API_KEY=
# THREE_D_GENERATOR_API_URL=https://api.meshy.ai/openapi/v2/text-to-3d

# --- Admin-Auth ---
ADMIN_SESSION_SECRET=change-me-in-production
# Serverseitiges Admin-Passwort (bevorzugt; nicht NEXT_PUBLIC_ verwenden in Produktion)
# ADMIN_PASSWORD=
# Fallback / lokale Entwicklung:
# NEXT_PUBLIC_ADMIN_PASSWORD=
# Passwort in Cosmos zuruecksetzen: node scripts/reset-staff-password.mjs admin --clear-2fa
# ADMIN_2FA_ENCRYPTION_KEY=

# --- Stripe (Shop-Checkout Kreditkarte & Webhooks) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Payrexx / TWINT (Shop-Checkout) ---
# Instance-Name aus der Payrexx-URL (z. B. dripforge bei dripforge.payrexx.com)
PAYREXX_INSTANCE_NAME=
# API Secret aus Payrexx Admin → API & Apps
PAYREXX_API_SECRET=
# Signing Key des Webhooks (Payrexx Admin → Webhooks → dein Endpoint)
PAYREXX_WEBHOOK_SIGNING_KEY=

# --- Öffentliche Site-URL (Redirect-URLs für Stripe/Payrexx) ---
# NEXT_PUBLIC_SITE_URL=https://www.dripforge.ch

# Die Hostpoint SMTP-Konfiguration für den Versand
# Pflicht: SMTP_USER + SMTP_PASS (HOST/PORT haben Defaults)
SMTP_HOST=mail.hostpoint.ch
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=shop@dripforge.ch
# Passwörter mit $ in Anführungszeichen setzen, sonst frisst dotenv die $$.
# Beispiel: SMTP_PASS='mein$Passwort'
SMTP_PASS=
EMAIL_FROM="DripForge <shop@dripforge.ch>"
ADMIN_EMAIL=shop@dripforge.ch
ADMIN_NOTIFY_EMAIL=shop@dripforge.ch
#
# WICHTIG (Azure App Settings): Werte OHNE umschliessende Anführungszeichen speichern,
# ausser das Passwort enthält Sonderzeichen — dann in Azure normal eingeben (kein dotenv).
# Lokal (.env.local): Passwörter mit $ in einfachen Anführungszeichen: SMTP_PASS='...'
#
# Test: npm run test:smtp
# Optional Empfänger: npm run test:smtp -- shop@dripforge.ch

# --- WhatsApp Live-Chat (Meta Cloud API — Website ↔ Admin) ---
# Phone Number ID aus Meta Developer Console → WhatsApp → API Setup
META_PHONE_NUMBER_ID=
# WhatsApp Business Account ID (WABA)
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
# Permanent System User Token mit whatsapp_business_messaging
META_ACCESS_TOKEN=
# Frei wählbarer String für Webhook-Verifizierung (Meta Developer Console)
META_VERIFY_TOKEN=
# Admin-Handynummer für Benachrichtigungen & Antwort-Validierung (z. B. 41791234567)
META_ADMIN_PHONE_NUMBER=

# --- Tawk.to Live-Chat (eigenes UI, Widget im Hintergrund) ---
# NEXT_PUBLIC_TAWK_PROPERTY_ID=6a43f45c113c4b1d489fcf7e
# NEXT_PUBLIC_TAWK_WIDGET_ID=1jscn52fl
