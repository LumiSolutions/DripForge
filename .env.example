# =============================================================================
# DripForge — lokale Entwicklung (.env.local)
# Kopiere diese Datei: cp .env.example .env.local
# =============================================================================

# --- Azure Cosmos DB (Pflicht für persistente Admin-Daten) ---
COSMOSDB_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOSDB_KEY=your-cosmos-primary-key
COSMOSDB_DATABASE=dripforge

# --- 3D-KI-Generator (Text/Image-to-3D, Standard: Meshy AI) ---
# Ohne Key: Demo-GLB auf /konfigurator/ai
THREE_D_GENERATOR_API_KEY=
# THREE_D_GENERATOR_API_URL=https://api.meshy.ai/openapi/v2/text-to-3d

# --- Admin-Auth ---
ADMIN_SESSION_SECRET=change-me-in-production
# ADMIN_2FA_ENCRYPTION_KEY=

# --- Stripe (optional) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- E-Mail (optional) ---
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
